APP_NAME="Salon SaaS"
APP_ENV=local
APP_KEY=
# Convenient for local development (verbose error pages). Production MUST
# override this to false — a debug response leaks stack traces, SQL
# queries, and file paths. See SECURITY_HARDENING.md, "Environment security".
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salon_saas
DB_USERNAME=salon_saas
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_TOKEN_EXPIRATION=10080

# Phase 10 SaaS billing — see SAAS_BILLING_ARCHITECTURE.md. PAYMENT_KEY is a
# public/publishable identifier (safe in a client SDK); PAYMENT_SECRET and
# PAYMENT_WEBHOOK_SECRET are server-only secrets — never commit real values
# here or anywhere else. Always use Razorpay *test/sandbox* credentials
# outside production; real payment attempts are never made in development.
PAYMENT_GATEWAY=razorpay
PAYMENT_GATEWAY_MODE=test
PAYMENT_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# How many days a PAST_DUE/GRACE_PERIOD subscription stays reachable before
# being marked EXPIRED. Business-feature access (not billing/renewal, which
# always remains reachable) is blocked once EXPIRED — see
# EnsureActiveSubscription.
SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# Prefix for generated invoice numbers, e.g. INV-2026-000001.
BILLING_INVOICE_PREFIX=INV

# Phase 11 notifications — see NOTIFICATION_ARCHITECTURE.md. All of the
# below are placeholders; never commit real credentials. Every channel
# degrades gracefully when its credentials are absent (delivery is marked
# SKIPPED, never silently claimed as sent) — see
# NotificationPreferenceResolver / NotificationDispatcher.

# Firebase Cloud Messaging (HTTP v1 API) — service-account credentials from
# the Firebase console (Project settings > Service accounts > Generate new
# private key). FCM_PRIVATE_KEY must keep its literal "\n" line breaks intact
# when quoted here.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# WhatsApp — official Meta WhatsApp Cloud API only (see
# NOTIFICATION_ARCHITECTURE.md; never an unofficial/automation-based client).
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# No SMS vendor has been selected yet — see NOTIFICATION_ARCHITECTURE.md,
# "SMS architecture". SmsProviderInterface currently binds to LogSmsProvider
# regardless of these values.
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM=
